
name: Angular Full Stack CI

on:
  push:
    branches:
      - main

  pull_request:
    branches:
      - main

permissions:
  contents: read

jobs:

  # ======================================
  # 1. FRONTEND - ANGULAR
  # ======================================

  frontend:
    name: Angular - Tests y Build
    runs-on: ubuntu-latest

    steps:
      - name: Descargar repositorio
        uses: actions/checkout@v4

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm

      - name: Instalar dependencias Angular
        run: npm ci

      - name: Ejecutar pruebas Angular
        run: npm run test:ci

      - name: Compilar Angular
        run: npm run build:prod

      - name: Guardar build
        uses: actions/upload-artifact@v4
        with:
          name: angular-production-build
          path: dist/
          retention-days: 7

  # ======================================
  # 2. BACKEND - EXPRESS + SQLITE
  # ======================================

  backend:
    name: Express - Tests de Integración
    runs-on: ubuntu-latest

    defaults:
      run:
        working-directory: backend

    steps:
      - name: Descargar repositorio
        uses: actions/checkout@v4

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm
          cache-dependency-path: backend/package-lock.json

      - name: Instalar dependencias Express
        run: npm ci

      - name: Ejecutar pruebas backend
        run: npm test

  # ======================================
  # 3. E2E - PLAYWRIGHT
  # ======================================

  e2e:
    name: Playwright - E2E y Accesibilidad
    runs-on: ubuntu-latest

    needs:
      - frontend
      - backend

    env:
      DATABASE_PATH: /tmp/proyecto-angular-e2e.sqlite
      FRONTEND_URL: http://localhost:4200
      E2E_EMAIL: admin-e2e@example.test
      E2E_PASSWORD: E2E-Test-Password-2026!

    steps:
      # Descargar código

      - name: Descargar repositorio
        uses: actions/checkout@v4

      # Instalar Node.js

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm

      # Instalar Angular

      - name: Instalar dependencias Angular
        run: npm ci

      # Instalar Express

      - name: Instalar dependencias Express
        working-directory: backend
        run: npm ci

      # Instalar navegador Chromium

      - name: Instalar Chromium
        run: npx playwright install --with-deps chromium

      # Crear cuenta de administrador E2E

      - name: Crear cuenta de pruebas E2E
        working-directory: backend
        run: npx tsx src/tests/seed-e2e.ts

      # Iniciar Express

      - name: Iniciar API Express
        working-directory: backend
        run: |
          npm run dev > /tmp/express-e2e.log 2>&1 &
          echo $! > /tmp/express-e2e.pid

          for i in $(seq 1 30); do
            if curl --fail --silent \
              http://127.0.0.1:3000/api/health > /dev/null; then
              echo "API Express disponible"
              exit 0
            fi

            sleep 2
          done

          cat /tmp/express-e2e.log
          exit 1

      # Ejecutar pruebas Playwright

      - name: Ejecutar pruebas E2E
        run: npm run test:e2e
        env:
          CI: 'true'

      # Guardar logs si falla Express

      - name: Guardar logs de Express
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: express-e2e-logs
          path: /tmp/express-e2e.log
          if-no-files-found: ignore

      # Guardar informes Playwright

      - name: Guardar informe Playwright
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: |
            playwright-report/
            test-results/
          if-no-files-found: ignore
          retention-days: 7
