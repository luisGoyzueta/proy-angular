    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@primeuix/themes": "^3.1.0",
    "chart.js": "^4.6.1",
    "primeicons": "^8.0.2",
    "primeng": "^21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
